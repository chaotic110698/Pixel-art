{
  "Name": "Pixel Atelier",
  "Version": "1.1.0.0",
  "Author": "Pixel Atelier",
  "Description": "Pilote l'avatar PNGtuber de Pixel Atelier (expressions, effets, fonds, profils, parler), même quand un jeu est au premier plan.",
  "URL": "https://chaotic110698.github.io/Pixel-art/",
  "UUID": "com.pixelatelier.avatar",
  "Icon": "imgs/plugin",
  "Category": "Pixel Atelier",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "Nodejs": { "Version": "20", "Debug": "disabled" },
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.4" },
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac", "MinimumVersion": "12" }
  ],
  "Actions": [
    {
      "UUID": "com.pixelatelier.avatar.expression",
      "Name": "Expression",
      "Tooltip": "Change l'expression de l'avatar (bascule, ou temporaire tant que la touche est appuyée)",
      "Icon": "imgs/actions/expression",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "imgs/keys/expression", "TitleAlignment": "bottom", "FontSize": "10" },
        { "Image": "imgs/keys/expression_on", "TitleAlignment": "bottom", "FontSize": "10" }
      ]
    },
    {
      "UUID": "com.pixelatelier.avatar.effect",
      "Name": "Effet",
      "Tooltip": "Lance un effet (confettis, cœurs…) ou allume / éteint une ambiance (neige, pluie…)",
      "Icon": "imgs/actions/effect",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "imgs/keys/effect", "TitleAlignment": "bottom", "FontSize": "10" },
        { "Image": "imgs/keys/effect_on", "TitleAlignment": "bottom", "FontSize": "10" }
      ]
    },
    {
      "UUID": "com.pixelatelier.avatar.background",
      "Name": "Fond",
      "Tooltip": "Change le fond de l'avatar (couleur unie ou décor animé)",
      "Icon": "imgs/actions/background",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "imgs/keys/background", "TitleAlignment": "bottom", "FontSize": "10" },
        { "Image": "imgs/keys/background_on", "TitleAlignment": "bottom", "FontSize": "10" }
      ]
    },
    {
      "UUID": "com.pixelatelier.avatar.profile",
      "Name": "Profil",
      "Tooltip": "Change de tenue ou de personnage",
      "Icon": "imgs/actions/profile",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "imgs/keys/profile", "TitleAlignment": "bottom", "FontSize": "10" },
        { "Image": "imgs/keys/profile_on", "TitleAlignment": "bottom", "FontSize": "10" }
      ]
    },
    {
      "UUID": "com.pixelatelier.avatar.talk",
      "Name": "Parler",
      "Tooltip": "Fait parler l'avatar tant que la touche est appuyée (ou bascule)",
      "Icon": "imgs/actions/talk",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "States": [
        { "Image": "imgs/keys/talk", "TitleAlignment": "bottom", "FontSize": "10" },
        { "Image": "imgs/keys/talk_on", "TitleAlignment": "bottom", "FontSize": "10" }
      ]
    }
  ]
}
